# Copy to .env and adjust. Loaded by docker-compose / your shell.
# Do NOT commit the real .env (it is gitignored).

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/seatvault
DB_USERNAME=seatvault
DB_PASSWORD=seatvault
DB_POOL_SIZE=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security ---
# Must be at least 256 bits (32+ chars) for HS256 signing.
JWT_SECRET=change-me-in-prod-this-is-a-dev-only-secret-key-0123456789
JWT_EXPIRATION_MINUTES=60

# --- Bootstrap admin (seeded on first start if absent; OVERRIDE in production) ---
# The UI no longer displays these; they live here for local/dev convenience only.
ADMIN_EMAIL=admin@seatvault.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Platform Admin

# --- Booking rules ---
HOLD_DURATION_MINUTES=5
BOOKING_RATE_MAX=10
BOOKING_RATE_WINDOW=60

# --- Pricing ---
# Money is stored in MINOR units (e.g. paise/cents). Pricing is set per-event at
# creation time (currency / base price / convenience fee / optional seat tiers);
# there are no global price env vars. Bookings freeze their payable amount at hold
# time, and the payment gateway charges that stored amount.
